# Editor defaults that match the repo's formatters: Prettier for frontend/ (2 spaces, 100 columns)
# and the opt-in Palantir Java profile (4 spaces, 120 columns). JetBrains and VS Code read this
# file natively; it never changes how the formatters themselves run.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[frontend/**.{ts,tsx,js,mjs,css,json,html}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{sh,py}]
indent_size = 4

[Makefile]
indent_style = tab
