# syntax=docker/dockerfile:1
# Build the reviewed packaged JAR first. The release script records JAR SHA and source revision.
FROM eclipse-temurin:21-jre@sha256:7a65df4b22d2de92d4e04056e884f3b9122d70b21e2847fd66084278bd0ce037
ARG JAR_FILE=target/sba-agentic-0.1.0.jar
ARG SOURCE_REVISION=unverified
ARG JAR_SHA256=unverified
LABEL org.opencontainers.image.title="Black Box" \
      org.opencontainers.image.revision=$SOURCE_REVISION \
      io.blackbox.jar-sha256=$JAR_SHA256 \
      io.blackbox.cloud-contract="postgres-auth-v1"
WORKDIR /app
RUN groupadd --gid 10001 blackbox \
    && useradd --uid 10001 --gid 10001 --home-dir /home/blackbox --create-home --shell /usr/sbin/nologin blackbox \
    && mkdir -p /data /opt/blackbox/certs \
    && chown 10001:10001 /data
# Official regional RDS CA bundle, verified 2026-09-08. Update checksum explicitly when CA set changes.
ADD --checksum=sha256:d46e1bdfda05c8e7644e50930806a19b139a222542bf0348082fb59ece2b5fa5 --chmod=0444 https://truststore.pki.rds.amazonaws.com/us-east-2/us-east-2-bundle.pem /opt/blackbox/certs/us-east-2-bundle.pem
COPY --chown=10001:10001 ${JAR_FILE} /app/app.jar
RUN test "$JAR_SHA256" != "unverified" \
    && echo "$JAR_SHA256  /app/app.jar" | sha256sum --check --status
USER 10001:10001
ENV SBA_BIND_ADDRESS=0.0.0.0 SBA_PORT=8766 \
    SBA_DATASOURCE_URL=jdbc:sqlite:/data/black-box.db \
    SERVER_TOMCAT_THREADS_MAX=32 SERVER_TOMCAT_THREADS_MIN_SPARE=2
VOLUME /data
EXPOSE 8766
ENTRYPOINT ["java", "-Xms128m", "-Xmx512m", "-Xss512k", "-XX:MaxMetaspaceSize=192m", "-XX:ReservedCodeCacheSize=64m", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/app.jar"]
